# Venvs live outside the tree (OneDrive syncs venv contents); these are a
# Windows junction and a WSL symlink. Match without a trailing slash: Windows
# git cannot stat the WSL symlink's reparse tag, so ".venv-linux/" misses it.
.venv-linux
.venv-win
__pycache__/
.pytest_cache/
.mypy_cache/
.DS_Store

# Measurement run outputs - commit a run deliberately if it is worth keeping
pattern_run/
*_run/
# thru_run is the system-stability baseline the README and project note cite,
# so it travels with the repo rather than living only on the acquisition PC.
!thru_run/
node_modules/
frontend/dist/
runs/
